QMainWindow#mainWindow {
    background-color: #f4f6fa;
}

QWidget#contentArea {
    background-color: #f4f6fa;
}

QWidget#sidebar {
    background-color: #0f172a;
    border: none;
}

QLabel#brandLabel {
    color: #ffffff;
    font-size: 23px;
    font-weight: 700;
    letter-spacing: 2px;
}

QLabel#sidebarSubtitle {
    color: #95a4bf;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 1.4px;
    padding-bottom: 30px;
}

QLabel#sectionLabel {
    color: #8493ad;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.2px;
}

QPushButton#navButton {
    color: #cbd5e1;
    background-color: #1e293b;
    border: 1px solid transparent;
    border-radius: 8px;
    padding: 9px 11px;
    text-align: left;
    font-size: 12px;
    font-weight: 500;
}

QPushButton#navButton:hover {
    color: #ffffff;
    background-color: #334155;
}

QPushButton#navButton:checked,
QPushButton#navButton:pressed,
QPushButton#navButton:focus {
    color: #ffffff;
    background-color: #3977e8;
    border: 1px solid #3977e8;
    font-weight: 600;
}

QPushButton#aboutButton {
    color: #e2e8f0;
    background-color: #1e293b;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 9px 12px;
    text-align: left;
    font-size: 12px;
}

QPushButton#aboutButton:hover {
    color: #ffffff;
    background-color: #334155;
}

QPushButton#aboutButton:pressed,
QPushButton#aboutButton:checked,
QPushButton#aboutButton:focus {
    color: #ffffff;
    background-color: #3977e8;
    border-color: #3977e8;
}

QLabel#pageTitle {
    color: #17233b;
    font-size: 25px;
    font-weight: 700;
}

QLabel#pageDescription {
    color: #718096;
    font-size: 13px;
    padding-bottom: 4px;
}

QFrame#chartFrame {
    background-color: #ffffff;
    border: 1px solid #e5e9f0;
    border-radius: 12px;
}

QLabel#aboutHeading {
    color: #17233b;
    font-size: 20px;
    font-weight: 700;
}

QLabel#aboutDescription {
    color: #58677f;
    font-size: 13px;
    line-height: 1.4;
}

QLabel#repositoryLink a {
    color: #3977e8;
}

QPushButton#secondaryButton {
    color: #0f172a;
    background-color: #e2e8f0;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
    padding: 8px 18px;
    font-weight: bold;
}

QPushButton#secondaryButton:hover,
QPushButton#secondaryButton:pressed,
QPushButton#secondaryButton:checked,
QPushButton#secondaryButton:focus {
    color: #ffffff;
    background-color: #3977e8;
    border-color: #3977e8;
}

QToolBar#plotToolbar {
    background-color: #ffffff;
    border: none;
    spacing: 5px;
}

QToolBar#plotToolbar QToolButton {
    color: #0f172a;
    background-color: #f8fafc;
    border: 1px solid #cbd5e1;
    border-radius: 4px;
    padding: 4px;
    min-width: 28px;
    min-height: 28px;
}

QToolBar#plotToolbar QToolButton:hover {
    background-color: #e2e8f0;
}

QToolBar#plotToolbar QToolButton:checked {
    color: #ffffff;
    background-color: #3977e8;
    border-color: #2e68d1;
}

QDialog {
    color: #0f172a;
    background-color: #ffffff;
}

QDialog QLabel {
    color: #0f172a;
    background-color: transparent;
}

QDialog QLineEdit,
QDialog QComboBox,
QDialog QSpinBox,
QDialog QDoubleSpinBox {
    color: #0f172a;
    background-color: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 3px;
    padding: 3px 5px;
    selection-color: #ffffff;
    selection-background-color: #3977e8;
}

QDialog QComboBox QAbstractItemView {
    color: #0f172a;
    background-color: #ffffff;
    selection-color: #ffffff;
    selection-background-color: #3977e8;
}

QDialog QCheckBox {
    color: #0f172a;
    background-color: transparent;
}

QDialog QPushButton {
    color: #0f172a;
    background-color: #f8fafc;
    border: 1px solid #cbd5e1;
    border-radius: 3px;
    padding: 4px 10px;
}

QDialog QPushButton:hover,
QDialog QPushButton:pressed {
    color: #0f172a;
    background-color: #e2e8f0;
}

QDialog QTabWidget::pane {
    background-color: #ffffff;
    border: 1px solid #cbd5e1;
}

QDialog QTabBar::tab {
    color: #0f172a;
    background-color: #f8fafc;
    border: 1px solid #cbd5e1;
    padding: 5px 9px;
}

QDialog QTabBar::tab:selected {
    background-color: #ffffff;
}